# Spotisync Environment Configuration
# ====================================
# Copy this file to .env and customize the values

# ------------------------------------------
# REQUIRED SETTINGS
# ------------------------------------------

# JWT Secret Key (generate a random 32+ character string)
# Example: openssl rand -hex 32
SPOTISYNC_SECRET_KEY=

# ------------------------------------------
# PATHS
# ------------------------------------------

# Where to save downloaded music (host machine path)
MUSIC_LIBRARY_PATH=./music

# ------------------------------------------
# STORAGE SETTINGS
# ------------------------------------------

# Storage backend type: "local" (default) or "sftp"
# Local storage saves files to the local filesystem
# SFTP storage saves files directly to a remote SFTP server
#STORAGE_TYPE=local

# SFTP Configuration (only used when STORAGE_TYPE=sftp)
# SFTP server hostname or IP address
#SFTP_HOST=sftp.example.com

# SFTP server port (default: 22)
#SFTP_PORT=22

# SFTP username for authentication
#SFTP_USERNAME=your_username

# SFTP password (optional if using SSH key)
#SFTP_PASSWORD=your_password

# Path to SSH private key file (optional if using password)
# Example: /path/to/id_rsa or ~/.ssh/id_rsa
#SFTP_SSH_KEY_PATH=/path/to/private_key

# Remote path on SFTP server where music will be stored
# Example: /home/user/music or /media/music
#SFTP_REMOTE_PATH=/path/to/remote/music

# ------------------------------------------
# DOCKER NETWORKING
# ------------------------------------------

# Frontend API URL - Required for frontend to connect to backend
# For Docker: Use http://backend:8080 (internal Docker network)
# For external access: Use http://your-server-ip:8080 or your-domain.com
#NEXT_PUBLIC_API_URL=http://backend:8080

# ------------------------------------------
# OPTIONAL: Spotify API Credentials
# ------------------------------------------
# Built-in credentials are used by default (no configuration needed!)
# Only set these if you want to use your own Spotify app credentials

#SPOTIFY_CLIENT_ID=
#SPOTIFY_CLIENT_SECRET=

# ------------------------------------------
# OPTIONAL: Server Settings
# ------------------------------------------

#SPOTISYNC_PORT=8080
#FRONTEND_PORT=3000
#SPOTISYNC_WORKERS=2
#SPOTISYNC_LOG_LEVEL=info
#SPOTISYNC_ENV=production

# ------------------------------------------
# OPTIONAL: Navidrome Integration
# ------------------------------------------
# Configure to enable automatic library scanning and playlist sync

#NAVIDROME_HOST=http://navidrome:4533
#NAVIDROME_USER=admin
#NAVIDROME_PASS=

# ------------------------------------------
# OPTIONAL: Official API Credentials
# ------------------------------------------
# By default, Spotisync uses third-party APIs that require no credentials.
# Only set these if you want to use official API credentials.

#TIDAL_CLIENT_ID=
#TIDAL_CLIENT_SECRET=
#QOBUZ_APP_ID=
#QOBUZ_SECRET=
